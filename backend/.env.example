# Copy to .env and fill in. Never commit .env.
PORT=3005

# Apify (https://console.apify.com/account/integrations). Leave APIFY_DATASET_ID unset to use built-in mock leads.
APIFY_TOKEN=your_apify_token
APIFY_DATASET_ID=your_dataset_id

# Zynd AI
ZYND_API_KEY=your_zynd_api_key
ZYND_REGISTRY_URL=https://zns01.zynd.ai
ZYND_WEBHOOK_PORT=5001
ZYND_ENTITY_URL=http://localhost:5001
ZYND_AGENT_PRIVATE_KEY=your_agent_private_key

# Superplane. Leave the key as a "your_" placeholder to use mock workflow ids.
SUPERPLANE_API_KEY=your_superplane_key
SUPERPLANE_BASE_URL=https://api.superplane.com/v1
SUPERPLANE_CANVAS_ID=gig-hunter-main

# Browser origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3000

# Optional but recommended: when set, POST /api/ingest requires this value in an `x-api-key` header
INGEST_API_KEY=
